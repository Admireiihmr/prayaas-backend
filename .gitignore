.env
venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

logs/

# Generated by the evaluation pipeline.
artifacts/metrics.json
artifacts/predictions.csv
artifacts/image_index.csv

# 123 MB of training images. They live in the original repo and are not needed
# to run the API — the model ships pretrained.
artifacts/raw_data/*
!artifacts/raw_data/.gitkeep

# model_weights.keras is committed via git-lfs (see .gitattributes). If you would
# rather not store 73 MB in the repo, ignore it here — model_loader.py downloads
# it from MODEL_URL on first use.
!artifacts/models/
