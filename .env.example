APP_NAME=Prayaas API
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173

# Neon PostgreSQL connection string (Dashboard -> Connection Details).
# Keep the real value in .env only — .env is gitignored, this file is not.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require&channel_binding=require

# Signs JWTs. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
JWT_EXPIRE_MINUTES=10080

# Pretrained weights, downloaded to artifacts/models/ if missing.
MODEL_URL=https://huggingface.co/akhilarayampalli/Prayaas/resolve/main/model_weights.keras
MODEL_JSON_URL=https://huggingface.co/akhilarayampalli/Prayaas/resolve/main/model.json

IMAGE_SIZE=224
APPLY_CLAHE=true
CLAHE_CLIP_LIMIT=2.0
BATCH_SIZE=32

# The model has a third class (OPMD) with no folder on disk. When scoring against
# the two raw_data folders, does a predicted OPMD count as CANCER or NON CANCER?
# true matches how this dataset is labelled (75 of 500 CANCER images predict OPMD,
# vs 2 of 200 NON CANCER) and is the safer screening default. See backend/README.md.
OPMD_IS_CANCER=true
